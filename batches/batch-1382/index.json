{"batch":1382,"files":[{"name":"8720b41b25c9.mp3","text":"彼らは山で遭難した。","sha256":"db65b86ba19f6a26e0dfb4d074cb3307c897c0f2eba24689afa1ecf2ed2aaa0e","size":10749},{"name":"87b31d26120e.mp3","text":"彼女は意地悪女だ。","sha256":"b116fc4eedbc48e911a6ec7598975f0acb3f484a970d7a640dbdbba45d26c084","size":10461},{"name":"8876d7380a31.mp3","text":"彼女は贈るものを紙で包んだ。","sha256":"8bda1ccf8d0eb5f8689494abeae175ba45552cada8b902e3c9d2d978bb92a002","size":13917},{"name":"8a096e3a5b1b.mp3","text":"彼女は腰掛けて足を組んだ。","sha256":"1ab1e0b65c6ec71fdc8262e771de6b785f1847f9e758e6065ed89eacacc7e7a9","size":12477},{"name":"8c8aacfab136.mp3","text":"彼らは彼女を待遇してきた。","sha256":"f12e29704cfd7320b5d6471f736948368df542fa33b13f4fa808c576b1d4e61b","size":12477},{"name":"8d318bf4534f.mp3","text":"彼女は両膝に肘をのせた。","sha256":"980e651df4c1f9b328699d0c23858cb8b21ca514d16836881af0df6ef47a42c9","size":12909},{"name":"8d60f21f6ed5.mp3","text":"彼女は可愛い。","sha256":"53a52de9353e7323a988e30a1255fcaa0f3adc6a8fc0d19fb7ed3329306bf22c","size":7581},{"name":"8d7f3c27a5eb.mp3","text":"彼女は先端を行っています。","sha256":"796f110201f536f086944fbdc4428e1338edc670a6b543ba8153ec895509b3db","size":12045},{"name":"8f143b08ebe1.mp3","text":"彼女は存命中キリスト教徒であった。","sha256":"f050770a9b525b4df72420c224b0188ee364d58f843b7f72e97698487475a51a","size":16221},{"name":"91112f320145.mp3","text":"彼らは険しい北面を登った。","sha256":"1c3235fd0d74ac6685ac3483451bf17e8aeb1ab1351f87f9072493680f874dd1","size":13629}]}
