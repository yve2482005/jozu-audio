{"batch":1387,"files":[{"name":"b6e195980ed1.mp3","text":"彼らは俳優です。","sha256":"434eefafd5de396322d478286fe9e68c26daff71553060dbfc87d5447baf21dd","size":8733},{"name":"b80fd5ce7677.mp3","text":"彼女は有機化学を専攻している。","sha256":"43aad2474a480f89eeee164891b7b65c3e0803cc7018cfb1c7693636f699dad5","size":15069},{"name":"b9dbe1f23f26.mp3","text":"彼女は祖母から聞いた昔話を紡ぐ。","sha256":"5d410a52e217931bd99c4a1966aa8754887353ff84613cffceb3f03075ad63fd","size":17229},{"name":"ba3e4c2ee097.mp3","text":"彼女の瞳は青い。","sha256":"e2007c8f156cf144768fe098944bc66c3c06c6947e651a76a07614b2cd689e1f","size":9741},{"name":"babbd14a359a.mp3","text":"彼女は富豪と結婚する。","sha256":"2b9fa03b0f8b05fe407cd301973c8e9d4e547ced4927011ca4fb7a82f5304727","size":11901},{"name":"c093a920940c.mp3","text":"彼女はタイピストの職を得た。","sha256":"721bf7c8d08de84c51851e3a9b819e8b39ce0dd09f0605b623b6a28adcd3109c","size":12765},{"name":"c1b9bef27613.mp3","text":"彼女は親切だ。","sha256":"4632c531900cae3784f7b42c3269628de11097b92504699298bfc2c25fd6f248","size":8589},{"name":"c431baf1db87.mp3","text":"彼女の態度は私の自尊心を傷つけた。","sha256":"0ef0f7807a86ed99dec52e8830f296632a5aac2ff2678e390f86cfa33352276b","size":17805},{"name":"c436dfe26c33.mp3","text":"彼女は家事で忙しかった。","sha256":"8510ef37498631b892c0685960fa360c905ace3c7530213c459a2061437ca734","size":11901},{"name":"c4fc01713d13.mp3","text":"彼女は内股だ。","sha256":"5ad073298d0ac616815dde6f57fe108723754a430f019bfeeacda7dd782b5101","size":8445}]}
