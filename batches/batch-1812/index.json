{"batch":1812,"files":[{"name":"8a12b4af05a1.mp3","text":"私の母は毎朝パンを焼く。","sha256":"24f02416674150bb48333a57b42d5dc10f027f84b98ba6a66b727f68fafc7d3d","size":12765},{"name":"8a7515a3f697.mp3","text":"私は協調性がある。","sha256":"34abc3c504e9f0f2634921ab1a6239b11df665d73c9e331084e4e5350351b084","size":10893},{"name":"8cdb69cacbb2.mp3","text":"私の班はいつもにぎやかだ。","sha256":"1bc75dab49b79239617587ca4ffa66cc0fe30b7097b811ce75d707f29a964285","size":12477},{"name":"8d4a7b0842cd.mp3","text":"私は会議の日付を忘れた。","sha256":"d07291516c4cdeb407c352e650308f70b74770a6aa43204577587be937ef5ba3","size":13197},{"name":"8f45abef34cc.mp3","text":"私は、幽霊屋敷に行った。","sha256":"aeb57b42eb61971ec231b9c5e787fef5bd2323a5ffff83f91e6252eaa857a414","size":15213},{"name":"8fd659155ee5.mp3","text":"私の家の屋根は赤い。","sha256":"6b2cef02ac0458d0ece2919a9e396ad76520c437ce75e5fb8e05938cec255b46","size":10317},{"name":"925f08299ddd.mp3","text":"私はコマンドを得る。","sha256":"80cea0b5f8b1749e1511ad368572098537efd398ce3aeb342939b89fb4c8304a","size":9309},{"name":"930a6d95e3b8.mp3","text":"私と友に眠る。","sha256":"0102a1f69ad6699a73910cd247bb7cfc0322f0bafb7c454529a94f9d6847293f","size":8301},{"name":"930ad42d28ce.mp3","text":"私はあなたが新しい責務をうまくこなせるよう願っています。","sha256":"0a609ddcf31f6c1806a5f2d672668af85c9e48820519876c4e239a02aa7c2180","size":23853},{"name":"9633919b390b.mp3","text":"私が彼に５０ペンスを差し出すと、彼はそれを受け取った。","sha256":"c1968496b0d32163c092892e2d55e33cd2b2e0248e227cf32567988b7dedf851","size":25725}]}
